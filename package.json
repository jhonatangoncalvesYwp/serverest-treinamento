{
  "name": "serverest-treinamento",
  "version": "1.0.0",
  "private": true,
  "description": "ServeRest (API + loja) rodando na máquina do aluno, para o treinamento de Cypress",
  "scripts": {
    "start": "node iniciar.js",
    "zerar": "node zerar.js",
    "saml:subir": "docker compose -f saml/docker-compose.yml up -d --build",
    "saml:parar": "docker compose -f saml/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "serve": "14.2.6",
    "serverest": "3.2.2"
  }
}
